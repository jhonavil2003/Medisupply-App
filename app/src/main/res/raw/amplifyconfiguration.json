{
  "auth": {
    "plugins": {
      "awsCognitoAuthPlugin": {
        "CognitoUserPool": {
          "Default": {
            "PoolId": "buildconfig.USER_POOL_ID",
            "AppClientId": "buildconfig.USER_POOL_CLIENT_ID",
            "Region": "us-east-1"
          }
        }
      }
    }
  }
}